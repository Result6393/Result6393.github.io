{
  // Deployed at https://work-settings.aflibercept.workers.dev
  "name": "work-settings",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://result6393.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      // Replace with the ID of the "work-settings" KV namespace from the Cloudflare dashboard.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
  // Secret (set in the dashboard, never committed): AUTH_HASH — produced by https://result6393.github.io/settings/setup.html
}
